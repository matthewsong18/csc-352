#!/bin/bash

for test_file in tests/test*.in; do

	test_name="${test_file%.*}"

	test_name="${test_name#tests/}"

	echo "$test_name"
	
  # 1: Run count program
    	
  ./strmath < "$test_file" > tests/outputs/"$test_name"MyOut 2> tests/outputs/"$test_name"MyErr
    
	# 2: To myOut

  echo $? >> tests/outputs/"$test_name"MyOut
    
	# 3: Run program
    
	./exStrmath < "$test_file" > tests/outputs/"$test_name"ExOut 2> tests/outputs/"$test_name"ExErr
    
	# 4: To exOut
  echo $? >> tests/outputs/"$test_name"ExOut

  # 5: Print test results
  printf "Test File $test_name\n"
  printf "stdout diffs: $(diff tests/outputs/"$test_name"ExOut tests/outputs/"$test_name"MyOut)\n"
  printf "stderr diffs: $(diff tests/outputs/"$test_name"ExErr tests/outputs/"$test_name"MyErr)\n"
  printf "\n"
done
